{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Api-gateway (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/api-gateway/cmd/server",
      "cwd": "${workspaceFolder}",
      "env": {
        "ITEMS_DB_URL": "postgres://postgres:postgres@localhost:5432/items?sslmode=disable",
        "PORT": "8081",
        "DEV_LOG_FILE": "${workspaceFolder}/dev-logs/gateway-01.log",
        "SERVICE_NAME": "api-gateway"

    }
    },
    {
      "name": "Items (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/items/cmd/server",
      "cwd": "${workspaceFolder}",
      "env": {
        "ITEMS_DB_URL": "postgres://postgres:postgres@localhost:5432/items?sslmode=disable",
        "PORT": "8083",
        "DEV_LOG_FILE": "${workspaceFolder}/dev-logs/gateway.log",
        "SERVICE_NAME": "api-gateway"
      }
    },
    {
      "name": "CRM (launch)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/services/crm/cmd/server",
      "cwd": "${workspaceFolder}",
      "env": {
        "CRM_DB_URL": "postgres://postgres:postgres@localhost:5432/crm?sslmode=disable",
        "PORT": "8082",
        "DEV_LOG_FILE": "${workspaceFolder}/dev-logs/crm-01.log",
        "SERVICE_NAME": "crm"
      }
    }
  ],
  "compounds": [
    {
      "name": "Run both: items + crm",
      "configurations": ["Items (launch)", "CRM (launch)"]
    }
  ]
}